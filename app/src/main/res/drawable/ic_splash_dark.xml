<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Neo-Brutalist Shadow (White in dark mode) -->
    <item android:left="8dp" android:top="8dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="16dp" />
            <size android:width="120dp" android:height="120dp" />
        </shape>
    </item>

    <!-- Neo-Brutalist Card Background -->
    <item android:right="8dp" android:bottom="8dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neo_yellow" />
            <stroke android:width="4dp" android:color="@android:color/white" />
            <corners android:radius="16dp" />
            <size android:width="120dp" android:height="120dp" />
        </shape>
    </item>

    <!-- Foreground Icon -->
    <item
        android:drawable="@mipmap/ic_launcher_foreground"
        android:top="24dp"
        android:bottom="24dp"
        android:left="24dp"
        android:right="24dp" />
</layer-list>
